{
  "name": "talentradar",
  "version": "1.0.0",
  "description": "LinkedIn talent sourcing tool for recruiters",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "@anthropic-ai/sdk": "^0.20.9",
    "puppeteer": "^22.4.1",
    "concurrently": "^8.2.2",
    "csv-stringify": "^6.4.6",
    "uuid": "^9.0.1"
  }
}
